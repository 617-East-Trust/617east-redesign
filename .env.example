# 617 East Trust — Environment Variables
# Copy this file to .env (production) or reference when deploying.
# Never commit actual secrets.

# ── Analytics ──────────────────────────────────────────────────────────────────
# Umami (privacy-first analytics — self-hosted recommended).
# Set both to enable runtime injection.
ANALYTICS_ENDPOINT=https://analytics.example.com
ANALYTICS_WEBSITE_ID=your-public-umami-website-id

# Google Tag Manager container (preferred Wave 4). When set, client loads GTM
# only after cookie consent. Configure GA4 + Clarity tags inside the GTM UI.
# Example: GTM-XXXXXXX
GTM_ID=

# Google Analytics 4 — used when GTM_ID is empty (direct gtag load after consent).
GA4_ID=

# Microsoft Clarity — Project ID. Loaded after consent when GTM_ID is empty
# (or configure Clarity as a GTM tag when GTM_ID is set).
CLARITY_ID=

# ── Call tracking (Wave 4.2) ───────────────────────────────────────────────────
# CallRail company ID segment for swap.js (loaded after consent).
# Example path uses: https://cdn.callrail.com/companies/{CALLRAIL_SWAP_ID}/12/swap.js
CALLRAIL_SWAP_ID=

# Optional Vite build-time display number for tracking pool (client UI).
# VITE_CALL_TRACKING_DISPLAY=(910) 555-0100

# ── Social (optional Vite build-time) ──────────────────────────────────────────
# VITE_LINKEDIN_COMPANY=https://www.linkedin.com/company/617-east-trust
# VITE_LINKEDIN_FOUNDER=https://www.linkedin.com/in/your-slug
# VITE_FACEBOOK_URL=https://www.facebook.com/your-page

# ── Privacy / Consent ─────────────────────────────────────────────────────────
# Optional: POST webhook that receives a JSON event on each consent decision
CONSENT_RECORDER_URL=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
