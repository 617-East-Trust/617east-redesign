# 617 East Trust — Environment Variables
# Copy this file to .env (production) or reference when deploying.
# Never commit actual secrets.

# Analytics (Umami)
# Set both to enable analytics injection at runtime.
ANALYTICS_ENDPOINT=https://analytics.example.com
ANALYTICS_WEBSITE_ID=your-public-umami-website-id

# Server
PORT=3000
NODE_ENV=production