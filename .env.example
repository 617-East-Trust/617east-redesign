# 617 East Trust — Environment Variables
# Copy this file to .env (production) or reference when deploying.
# Never commit actual secrets.

# ── Analytics ──────────────────────────────────────────────────────────────────
# Umami (privacy-first analytics — self-hosted recommended).
# Set both to enable runtime injection.
ANALYTICS_ENDPOINT=https://analytics.example.com
ANALYTICS_WEBSITE_ID=your-public-umami-website-id

# First-party analytics pipeline (617-East-Trust/analytics-pipeline).
# Browser posts to same-origin /__analytics__/collect; Node proxies upstream
# and attaches Bearer token (token is NEVER injected into HTML).
# Examples:
#   ANALYTICS_COLLECT_URL=http://127.0.0.1:8080
#   ANALYTICS_COLLECT_URL=https://collect.617east.com/collect
# Leave empty to disable pipeline collection (GTM/Clarity still work if set).
ANALYTICS_COLLECT_URL=
ANALYTICS_COLLECT_TOKEN=

# Google Tag Manager container (preferred Wave 4). When set, client loads GTM
# only after cookie consent. Configure GA4 tags inside the GTM UI.
# Example: GTM-XXXXXXX
GTM_ID=

# Google Analytics 4 Measurement ID (G-XXXXXXXX). Used for direct gtag load
# when GTM_ID is empty. Not the numeric property ID.
# Example: G-ABC123XYZ
GA4_ID=

# Microsoft Clarity project ID (from clarity.ms tag URL …/tag/{id}).
# Loaded after consent even when GTM is set — do not also fire Clarity via GTM.
CLARITY_ID=

# ── Call tracking (Wave 4.2) ───────────────────────────────────────────────────
# CallRail DNI path from company script_url (after /companies/, before /12/swap.js).
# Example: 691070475/f39631053037308bcb99
# Full URL shape: https://cdn.callrail.com/companies/{CALLRAIL_SWAP_ID}/12/swap.js
# Do NOT put the ctrk_ API key here — that is for CallRail API only.
CALLRAIL_SWAP_ID=

# Optional Vite build-time display number for tracking pool (client UI).
# VITE_CALL_TRACKING_DISPLAY=(910) 555-0100

# ── Social (optional Vite build-time) ──────────────────────────────────────────
# VITE_LINKEDIN_COMPANY=https://www.linkedin.com/company/617-east-trust
# VITE_LINKEDIN_FOUNDER=https://www.linkedin.com/in/your-slug
# VITE_FACEBOOK_URL=https://www.facebook.com/your-page

# ── Privacy / Consent ─────────────────────────────────────────────────────────
# Optional: POST webhook that receives a JSON event on each consent decision
CONSENT_RECORDER_URL=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
